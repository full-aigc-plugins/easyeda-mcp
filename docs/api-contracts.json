    "PCB_ManufactureData.getGerberFile": {
      "title": "获取 PCB 制版文件（Gerber）",
      "params": [
        {
          "name": "fileName",
          "type": "string",
          "description": "文件名",
          "required": false
        },
        {
          "name": "colorSilkscreen",
          "type": "boolean",
          "description": "是否生成彩色丝印制造文件（嘉立创专用文件）",
          "required": false
        },
        {
          "name": "unit",
          "type": "\"mm\" | \"inch\"",
          "description": "单位",
          "required": false
        },
        {
          "name": "digitalFormat",
          "type": "{ integerNumber: number; decimalNumber: number }",
          "description": "数字格式，默认 `4:5`；使用英制（`ESYS_Unit.INCH`）时建议 `3:6`",
          "required": false
        },
        {
          "name": "other",
          "type": "{ metallicDrillingInformation: boolean; nonMetallicDrillingInformation: boolean; drillTable: boolean; flyingProbeTestingFile: boolean }",
          "description": "其它",
          "required": false
        },
        {
          "name": "layers",
          "type": "Array<{ layerId: EPCB_LayerId; isMirror: boolean }>",
          "description": "导出层，默认则与编辑器一键导出一致（板内真实使用的层 + 钻孔图层）",
          "required": false
        },
        {
          "name": "objects",
          "type": "Array<\"Pad\" | \"Via\" | \"Track\" | \"Text\" | \"Image\" | \"Dimension\" | \"BoardOutline\" | \"BoardCutout\" | \"CopperFilled\" | \"SolidRegion\" | \"FPCStiffener\" | \"Line\" | \"PlaneZone\" | \"ComponentProperty\" | \"ComponentSilkscreen\" | \"TearDrop\">",
          "description": "导出对象，默认则按照嘉立创生产需求导出",
          "required": false
        }
      ],
      "returns": {
        "type": "File | undefined",
        "description": "PCB 制版文件数据"
      },
      "isAsync": true
    },
    "PCB_ManufactureData.getBomFile": {
      "title": "获取 BOM 文件",
      "params": [
        {
          "name": "fileName",
          "type": "string",
          "description": "文件名",
          "required": false
        },
        {
          "name": "fileType",
          "type": "\"xlsx\" | \"csv\"",
          "description": "文件类型",
          "required": false
        },
        {
          "name": "template",
          "type": "string",
          "description": "模板名称",
          "required": false
        },
        {
          "name": "filterOptions",
          "type": "Array<{ property: string; includeValue: string | false | true }>",
          "description": "过滤规则，仅应包含需要启用的规则，`property` 为规则名称，`includeValue` 为匹配的值",
          "required": false
        },
        {
          "name": "statistics",
          "type": "Array<string>",
          "description": "统计，包含所有需要启用的统计项的名称",
          "required": false
        },
        {
          "name": "property",
          "type": "Array<string>",
          "description": "属性，包含所有需要启用的属性的名称",
          "required": false
        },
        {
          "name": "columns",
          "type": "Array<IPCB_BomPropertiesTableColumns>",
          "description": "列的属性及排序，`title`、`sort`、`group`、`orderWeight` 不传入则取默认值，`null` 代表 **无** 或 **空**",
          "required": false
        }
      ],
      "returns": {
        "type": "File | undefined",
        "description": "BOM 文件数据"
      },
      "isAsync": true
    },
    "PCB_ManufactureData.getPickAndPlaceFile": {
